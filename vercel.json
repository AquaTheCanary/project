{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home/",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/present/:id/host/",
      "destination": "/present/view/host/?id=:id"
    },
    {
      "source": "/present/:id/audience/",
      "destination": "/present/view/audience/?id=:id"
    },
    {
      "source": "/present/:id/",
      "destination": "/present/editor/?id=:id"
    },
    {
      "source": "/",
      "destination": "/home/index.html"
    }
  ]
}
