{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/presentation",
      "destination": "/present/",
      "permanent": true
    },
    {
      "source": "/presentation/",
      "destination": "/present/",
      "permanent": true
    },
    {
      "source": "/presentations",
      "destination": "/present/new/",
      "permanent": true
    },
    {
      "source": "/presentations/",
      "destination": "/present/new/",
      "permanent": true
    },
    {
      "source": "/presentations/new/",
      "destination": "/present/new/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/guest/canvas",
      "destination": "/canvas/?guest=1"
    },
    {
      "source": "/guest/canvas/",
      "destination": "/canvas/?guest=1"
    },
    {
      "source": "/guest/ready",
      "destination": "/ready/?guest=1"
    },
    {
      "source": "/guest/ready/",
      "destination": "/ready/?guest=1"
    },
    {
      "source": "/guest/present",
      "destination": "/present/?guest=1"
    },
    {
      "source": "/guest/present/",
      "destination": "/present/?guest=1"
    },
    {
      "source": "/guest/sites",
      "destination": "/sites/?guest=1"
    },
    {
      "source": "/guest/sites/",
      "destination": "/sites/?guest=1"
    },
    {
      "source": "/guest/forms",
      "destination": "/forms/?guest=1"
    },
    {
      "source": "/guest/forms/",
      "destination": "/forms/?guest=1"
    },
    {
      "source": "/communities/profiles/:handle/update",
      "destination": "/communities/profiles/update/index.html?handle=:handle"
    },
    {
      "source": "/communities/profiles/:handle/update/",
      "destination": "/communities/profiles/update/index.html?handle=:handle"
    },
    {
      "source": "/present/:id/host",
      "destination": "/present/view/host/?id=:id"
    },
    {
      "source": "/present/:id/audience",
      "destination": "/present/view/audience/?id=:id"
    },
    {
      "source": "/present/:id",
      "destination": "/present/editor/?id=:id"
    },
    {
      "source": "/present/:id/host/",
      "destination": "/present/view/host/?id=:id"
    },
    {
      "source": "/present/:id/audience/",
      "destination": "/present/view/audience/?id=:id"
    },
    {
      "source": "/present/:id/",
      "destination": "/present/editor/?id=:id"
    },
    {
      "source": "/",
      "destination": "/home/index.html"
    }
  ]
}
