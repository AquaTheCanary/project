rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(data) {
      return signedIn() && (
        data.get('ownerUid', '') == request.auth.uid ||
        data.get('uid', '') == request.auth.uid ||
        data.get('userId', '') == request.auth.uid
      );
    }
    function roomExists(code) {
      return exists(/databases/$(database)/documents/rooms/$(code));
    }
    function owner(code) {
      return signedIn() && roomExists(code)
        && get(/databases/$(database)/documents/rooms/$(code)).data.ownerUid == request.auth.uid;
    }

    match /rooms/{code} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'live'
        && code.size() == 6
        && code.matches('^[0-9]+$')
        && request.resource.data.slides is list
        && request.resource.data.slides.size() > 0
        && request.resource.data.slides.size() <= 150;
      allow get: if owner(code) || (resource.data.status == 'live' && code.size() == 6 && code.matches('^[0-9]+
      allow update: if owner(code)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.slides is list
        && request.resource.data.slides.size() > 0
        && request.resource.data.slides.size() <= 150
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'slides', 'activeSlide', 'status', 'updatedAt']);
      allow delete: if owner(code);

      match /participants/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || owner(code));
        allow create: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt']);
        allow delete: if owner(code);
      }

      match /votes/{voteId} {
        allow read: if owner(code);
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.choice is string
          && request.resource.data.choice.size() > 0
          && request.resource.data.choice.size() <= 120
          && request.resource.data.slideIndex is int
          && exists(/databases/$(database)/documents/rooms/$(code)/participants/$(request.auth.uid));
        allow update: if false;
        allow delete: if owner(code);
      }

      match /private/{docId} {
        allow read: if owner(code) && docId == 'notes';
        allow create, update: if owner(code) && docId == 'notes'
          && request.resource.data.ownerUid == request.auth.uid;
        allow delete: if owner(code) && docId == 'notes';
      }
    }


    match /forms/{formId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.fields is list
        && request.resource.data.fields.size() <= 40;
      allow get: if resource.data.get('published', false) == true || owns(resource.data);
      allow list: if signedIn() && resource.data.get('ownerUid', '') == request.auth.uid;
      allow update: if owns(resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.fields is list
        && request.resource.data.fields.size() <= 40;
      allow delete: if owns(resource.data);
    }
    match /formResponses/{responseId} {
      function publishedForm() {
        return exists(/databases/$(database)/documents/forms/$(request.resource.data.formId))
          && get(/databases/$(database)/documents/forms/$(request.resource.data.formId)).data.published == true;
      }
      allow create: if publishedForm()
        && request.resource.data.ownerUid
          == get(/databases/$(database)/documents/forms/$(request.resource.data.formId)).data.ownerUid
        && request.resource.data.answers is map
        && request.resource.data.answers.size() <= 40;
      // Response queries must include ownerUid == request.auth.uid so Firestore
      // can prove access for every returned document without a cross-document query.
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /websites/{slug} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.slug == slug
        && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.siteName is string
        && request.resource.data.headline is string;
      allow get: if resource == null
        || resource.data.get('status', '') == 'published'
        || owns(resource.data);
      allow list: if signedIn() && resource.data.get('ownerUid', '') == request.auth.uid;
      allow update: if owns(resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.status in ['draft', 'published'];
      allow delete: if owns(resource.data);
    }
    match /websitePaths/{publicSlug} {
      allow get: if resource == null
        || resource.data.get('status', '') == 'published'
        || owns(resource.data);
      allow list: if signedIn() && resource.data.get('ownerUid', '') == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.publicSlug == publicSlug
        && request.resource.data.websiteSlug is string
        && request.resource.data.status in ['draft', 'published'];
      allow update: if owns(resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.publicSlug == publicSlug
        && request.resource.data.websiteSlug == resource.data.websiteSlug
        && request.resource.data.status in ['draft', 'published'];
      allow delete: if owns(resource.data);
    }
    match /websiteHosts/{hostname} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.hostname == hostname
        && request.resource.data.websiteSlug is string
        && request.resource.data.status in ['draft', 'published'];
      allow get: if resource == null
        || resource.data.get('status', '') == 'published'
        || owns(resource.data);
      allow list: if signedIn() && resource.data.get('ownerUid', '') == request.auth.uid;
      allow update: if owns(resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.hostname == hostname
        && request.resource.data.websiteSlug == resource.data.websiteSlug
        && request.resource.data.status in ['draft', 'published'];
      allow delete: if owns(resource.data);
    }
    match /websiteDomains/{hostname} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.hostname == hostname
        && request.resource.data.status == 'pending';
      allow get: if resource == null
        || resource.data.get('status', '') == 'active'
        || owns(resource.data);
      allow list: if signedIn() && resource.data.get('ownerUid', '') == request.auth.uid;
      allow update: if owns(resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.hostname == resource.data.hostname
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'checkedAt', 'updatedAt']);
      allow delete: if owns(resource.data);
    }
    function isProjectAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin membership is provisioned manually with Firebase Console/Admin SDK.
    // Clients cannot grant themselves administrator access.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // A single public-readable document drives the announcement ticker.
    match /siteConfig/{configId} {
      allow get: if configId == 'announcements' || isProjectAdmin();
      allow list: if false;
      allow create, update, delete: if isProjectAdmin();
    }

    match /publicProfiles/{uid} {
      allow get: if (resource.data.visibility == 'public')
        || (signedIn() && request.auth.uid == uid);
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.handle is string
        && request.resource.data.visibility in ['public', 'private'];
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /userProfiles/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /handles/{handle} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.handle == handle
        && handle.matches('[a-z0-9][a-z0-9-]{1,22}[a-z0-9]');
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }


    // Project account and workspace foundation.
    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      function isMember() {
        return signedIn() && (
          resource.data.ownerUid == request.auth.uid ||
          (resource.data.memberUids is list && request.auth.uid in resource.data.memberUids)
        );
      }
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids;
      allow read: if isMember();
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /organisations/{organisationId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 160;
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.memberUids is list && request.auth.uid in resource.data.memberUids)
      );
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Presentr
    match /presentations/{presentationId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160;
      allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      match /slides/{slideId} {
        function presentationOwner() {
          return signedIn() && get(/databases/$(database)/documents/presentations/$(presentationId)).data.ownerUid == request.auth.uid;
        }
        allow read, write: if presentationOwner();
      }
    }

    // Siteify
    match /siteProjects/{siteId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 160;
      allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      match /pages/{pageId} {
        function siteOwner() {
          return signedIn() && get(/databases/$(database)/documents/siteProjects/$(siteId)).data.ownerUid == request.auth.uid;
        }
        allow read, write: if siteOwner();
      }
    }

    // Formr (new product-specific form collection; legacy /forms remains supported).
    match /formProjects/{formId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160;
      allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      match /responses/{responseId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/formProjects/$(formId)).data.ownerUid == request.auth.uid;
        allow create: if exists(/databases/$(database)/documents/formProjects/$(formId))
          && get(/databases/$(database)/documents/formProjects/$(formId)).data.published == true
          && request.resource.data.answers is map
          && request.resource.data.answers.size() <= 60;
        allow update, delete: if false;
      }
    }


    // Private project documents shared by Canvas, Ready and Present.
    match /users/{uid}/projects/{projectId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.type in ['canvas', 'ready', 'present']
        && request.resource.data.content is map
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160;
    }

    // User preferences are private and account-scoped.
    match /userSettings/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // Public community entries are immutable copies of a user's work.
    match /communityDesigns/{designId} {
      allow get, list: if resource.data.visibility == 'public';
      allow create: if signedIn()
        && request.resource.data.copyOwnerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.product in ['canvas', 'ready', 'present', 'forms', 'sites']
        && request.resource.data.content is map
        && request.resource.data.visibility == 'public';
      allow update: if false;
      allow delete: if signedIn() && resource.data.copyOwnerUid == request.auth.uid;
    }

    // Cloudbase file metadata. File bytes live in Firebase Storage.
    match /cloudbaseFiles/{fileId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 255
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('users/' + request.auth.uid + '/cloudbase/.*');
      allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.storagePath == resource.data.storagePath;
    }

  }
}
));
      allow list: if false;
      allow update: if owner(code)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.slides is list
        && request.resource.data.slides.size() > 0
        && request.resource.data.slides.size() <= 150
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'slides', 'activeSlide', 'status', 'updatedAt']);
      allow delete: if owner(code);

      match /participants/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || owner(code));
        allow create: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt']);
        allow delete: if owner(code);
      }

      match /votes/{voteId} {
        allow read: if owner(code);
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.choice is string
          && request.resource.data.choice.size() > 0
          && request.resource.data.choice.size() <= 120
          && request.resource.data.slideIndex is int
          && exists(/databases/$(database)/documents/rooms/$(code)/participants/$(request.auth.uid));
        allow update: if false;
        allow delete: if owner(code);
      }

      match /private/{docId} {
        allow read: if owner(code) && docId == 'notes';
        allow create, update: if owner(code) && docId == 'notes'
          && request.resource.data.ownerUid == request.auth.uid;
        allow delete: if owner(code) && docId == 'notes';
      }
    }


    match /forms/{formId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.fields is list
        && request.resource.data.fields.size() <= 40;
      allow get: if resource.data.get('published', false) == true || owns(resource.data);
      allow list: if signedIn() && resource.data.get('ownerUid', '') == request.auth.uid;
      allow update: if owns(resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.fields is list
        && request.resource.data.fields.size() <= 40;
      allow delete: if owns(resource.data);
    }
    match /formResponses/{responseId} {
      function publishedForm() {
        return exists(/databases/$(database)/documents/forms/$(request.resource.data.formId))
          && get(/databases/$(database)/documents/forms/$(request.resource.data.formId)).data.published == true;
      }
      allow create: if publishedForm()
        && request.resource.data.ownerUid
          == get(/databases/$(database)/documents/forms/$(request.resource.data.formId)).data.ownerUid
        && request.resource.data.answers is map
        && request.resource.data.answers.size() <= 40;
      // Response queries must include ownerUid == request.auth.uid so Firestore
      // can prove access for every returned document without a cross-document query.
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /websites/{slug} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.slug == slug
        && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.siteName is string
        && request.resource.data.headline is string;
      allow get: if resource == null
        || resource.data.get('status', '') == 'published'
        || owns(resource.data);
      allow list: if signedIn() && resource.data.get('ownerUid', '') == request.auth.uid;
      allow update: if owns(resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.status in ['draft', 'published'];
      allow delete: if owns(resource.data);
    }
    match /websitePaths/{publicSlug} {
      allow get: if resource == null
        || resource.data.get('status', '') == 'published'
        || owns(resource.data);
      allow list: if signedIn() && resource.data.get('ownerUid', '') == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.publicSlug == publicSlug
        && request.resource.data.websiteSlug is string
        && request.resource.data.status in ['draft', 'published'];
      allow update: if owns(resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.publicSlug == publicSlug
        && request.resource.data.websiteSlug == resource.data.websiteSlug
        && request.resource.data.status in ['draft', 'published'];
      allow delete: if owns(resource.data);
    }
    match /websiteHosts/{hostname} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.hostname == hostname
        && request.resource.data.websiteSlug is string
        && request.resource.data.status in ['draft', 'published'];
      allow get: if resource == null
        || resource.data.get('status', '') == 'published'
        || owns(resource.data);
      allow list: if signedIn() && resource.data.get('ownerUid', '') == request.auth.uid;
      allow update: if owns(resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.hostname == hostname
        && request.resource.data.websiteSlug == resource.data.websiteSlug
        && request.resource.data.status in ['draft', 'published'];
      allow delete: if owns(resource.data);
    }
    match /websiteDomains/{hostname} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.hostname == hostname
        && request.resource.data.status == 'pending';
      allow get: if resource == null
        || resource.data.get('status', '') == 'active'
        || owns(resource.data);
      allow list: if signedIn() && resource.data.get('ownerUid', '') == request.auth.uid;
      allow update: if owns(resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.hostname == resource.data.hostname
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'checkedAt', 'updatedAt']);
      allow delete: if owns(resource.data);
    }
    function isProjectAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin membership is provisioned manually with Firebase Console/Admin SDK.
    // Clients cannot grant themselves administrator access.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // A single public-readable document drives the announcement ticker.
    match /siteConfig/{configId} {
      allow get: if configId == 'announcements' || isProjectAdmin();
      allow list: if false;
      allow create, update, delete: if isProjectAdmin();
    }

    match /publicProfiles/{uid} {
      allow get: if (resource.data.visibility == 'public')
        || (signedIn() && request.auth.uid == uid);
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.handle is string
        && request.resource.data.visibility in ['public', 'private'];
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /userProfiles/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /handles/{handle} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.handle == handle
        && handle.matches('[a-z0-9][a-z0-9-]{1,22}[a-z0-9]');
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }


    // Project account and workspace foundation.
    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      function isMember() {
        return signedIn() && (
          resource.data.ownerUid == request.auth.uid ||
          (resource.data.memberUids is list && request.auth.uid in resource.data.memberUids)
        );
      }
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids;
      allow read: if isMember();
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /organisations/{organisationId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 160;
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.memberUids is list && request.auth.uid in resource.data.memberUids)
      );
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Presentr
    match /presentations/{presentationId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160;
      allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      match /slides/{slideId} {
        function presentationOwner() {
          return signedIn() && get(/databases/$(database)/documents/presentations/$(presentationId)).data.ownerUid == request.auth.uid;
        }
        allow read, write: if presentationOwner();
      }
    }

    // Siteify
    match /siteProjects/{siteId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 160;
      allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      match /pages/{pageId} {
        function siteOwner() {
          return signedIn() && get(/databases/$(database)/documents/siteProjects/$(siteId)).data.ownerUid == request.auth.uid;
        }
        allow read, write: if siteOwner();
      }
    }

    // Formr (new product-specific form collection; legacy /forms remains supported).
    match /formProjects/{formId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160;
      allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      match /responses/{responseId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/formProjects/$(formId)).data.ownerUid == request.auth.uid;
        allow create: if exists(/databases/$(database)/documents/formProjects/$(formId))
          && get(/databases/$(database)/documents/formProjects/$(formId)).data.published == true
          && request.resource.data.answers is map
          && request.resource.data.answers.size() <= 60;
        allow update, delete: if false;
      }
    }


    // Private project documents shared by Canvas, Ready and Present.
    match /users/{uid}/projects/{projectId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.type in ['canvas', 'ready', 'present']
        && request.resource.data.content is map
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160;
    }

    // User preferences are private and account-scoped.
    match /userSettings/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // Public community entries are immutable copies of a user's work.
    match /communityDesigns/{designId} {
      allow get, list: if resource.data.visibility == 'public';
      allow create: if signedIn()
        && request.resource.data.copyOwnerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.product in ['canvas', 'ready', 'present', 'forms', 'sites']
        && request.resource.data.content is map
        && request.resource.data.visibility == 'public';
      allow update: if false;
      allow delete: if signedIn() && resource.data.copyOwnerUid == request.auth.uid;
    }

    // Cloudbase file metadata. File bytes live in Firebase Storage.
    match /cloudbaseFiles/{fileId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 255
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('users/' + request.auth.uid + '/cloudbase/.*');
      allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.storagePath == resource.data.storagePath;
    }

  }
}
